#!/bin/sh
# ow: control the Outer Wilds desktop.  ow start | stop | restart | status | log | doctor | rescan | new-widget <name>
CFG=outerwilds
PIDF="${XDG_RUNTIME_DIR:-/tmp}/ow-${CFG}-supervise.pid"
supervised() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; }
stop_supervisor() { if supervised; then kill "$(cat "$PIDF")" 2>/dev/null; fi; rm -f "$PIDF"; }
case "$1" in
  start)   pgrep -f "qs.*-c $CFG" >/dev/null && { echo "already running"; exit 0; }
           setsid -f qs -c "$CFG" >/dev/null 2>&1 && echo started ;;
  supervise)   # autostart this one: starts the shell and restarts it if it crashes (gives up after 5 quick crashes in a row)
           supervised && { echo "already supervising"; exit 0; }
           setsid -f sh -c 'echo $$ > "$1"; fails=0
             while :; do
               t=$(date +%s); qs -c "$2" >/dev/null 2>&1; rc=$?
               [ "$rc" -eq 0 ] && break
               if [ $(( $(date +%s) - t )) -lt 10 ]; then fails=$((fails + 1)); else fails=0; fi
               [ "$fails" -ge 5 ] && break
               sleep 2
             done; rm -f "$1"' sh "$PIDF" "$CFG" && echo supervising ;;
  stop)    stop_supervisor; qs kill -c "$CFG" ;;
  restart) if supervised; then S=1; fi; stop_supervisor; qs kill -c "$CFG" 2>/dev/null; sleep 1
           if [ -n "$S" ]; then "$0" supervise; else setsid -f qs -c "$CFG" >/dev/null 2>&1 && echo restarted; fi ;;
  perf)    shift; case "$1" in set|cycle|diag|status) qs -c "$CFG" ipc call perf "$@" ;; *) echo "usage: ow perf set quality|balanced|performance | cycle | diag | status"; exit 1 ;; esac ;;
  status)  qs -c "$CFG" ipc call system status ;;
  log)     qs -c "$CFG" log ;;
  rescan)  qs -c "$CFG" ipc call widgets rescan ;;
  new-widget)
    NAME="$2"
    case "$NAME" in ""|*[!A-Za-z0-9_-]*) echo "usage: ow new-widget <name>   (letters, digits, - and _ only)"; exit 1 ;; esac
    DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/$CFG/widgets/user/$NAME"
    [ -e "$DIR" ] && { echo "$DIR already exists"; exit 1; }
    UP=$(echo "$NAME" | tr 'a-z' 'A-Z')
    mkdir -p "$DIR"
    cat > "$DIR/widget.json" <<EOF
{
  "name": "$NAME",
  "group": "Custom",
  "designW": 240,
  "title": "$UP",
  "default": { "show": "focus", "worldW": 120, "orbit": { "k": 2.0, "add": 40, "speed": 0.2 } },
  "settings": []
}
EOF
    cat > "$DIR/Main.qml" <<EOF
import QtQuick
import "../../.."          // the OW registry: WidgetCard, WidgetData, Sensors, ...

WidgetCard {
    id: w
    title: "$UP"
    designW: 240
    designH: 110

    // options from widget.json "settings" arrive here as cfg.<key> (keep the defaults equal to widget.json's)
    property var cfg: ({})

    Text {
        anchors.centerIn: parent
        text: Qt.formatTime(WidgetData.now, "HH:mm:ss")
        color: w.cCream
        font.family: "monospace"
        font.pixelSize: Math.max(8, Math.round(28 * w.ui))      // always scale sizes by w.ui
    }
}
EOF
    echo "created $DIR"
    echo "next: ow rescan, then add it from the settings panel (+ ADD, group: Custom); see WIDGETS.md" ;;
  doctor)
    for c in qs hyprctl busctl noctalia cava gtk-launch; do
      if command -v "$c" >/dev/null 2>&1; then echo "ok       $c"; else echo "MISSING  $c"; fi
    done
    echo; echo "session bus notification owner:"; busctl --user status org.freedesktop.Notifications 2>&1 | grep -E "^(PID|Comm)"
    echo; echo "hwmon sensors:"; for h in /sys/class/hwmon/hwmon*; do printf '%s ' "$(cat $h/name 2>/dev/null)"; done; echo
    echo; echo "gpu busy file:"; ls /sys/class/drm/card*/device/gpu_busy_percent 2>&1 | head -1
    echo; echo "layer surface:"; hyprctl layers 2>/dev/null | grep -i outerwilds || echo "  (not running)"
    echo; echo "shell status:"; qs -c "$CFG" ipc call system status 2>&1 | head -3 ;;
  *) echo "usage: ow start|stop|restart|status|log|doctor|rescan|new-widget <name>"; exit 1 ;;
esac
