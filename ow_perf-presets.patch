+  supervise)   # autostart this one: starts the shell and restarts it if it crashes (gives up after 5 quick crashes in a row)
+           supervised && { echo "already supervising"; exit 0; }
+           setsid -f sh -c 'echo $$ > "$1"; fails=0
+             while :; do
+               t=$(date +%s); qs -c "$2" >/dev/null 2>&1; rc=$?
