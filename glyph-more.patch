diff --git a/widgets/glyph/GlyphAudioData.qml b/widgets/glyph/GlyphAudioData.qml
new file mode 100644
index 0000000..910e336
--- /dev/null
+++ b/widgets/glyph/GlyphAudioData.qml
@@ -0,0 +1,45 @@
+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import "../.."
+
+// Default output volume through wpctl (PipeWire). Polled every 2 s while the scene is visible.
+Singleton {
+    id: root
+    property real vol: 0
+    property bool muted: false
+    property bool ok: false
+
+    function setVol(v) {
+        v = Math.max(0, Math.min(1, v));
+        root.vol = v;
+        setProc.command = ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", v.toFixed(2)];
+        setProc.running = true;
+    }
+    function toggleMute() {
+        root.muted = !root.muted;
+        muteProc.running = true;
+    }
+
+    Timer {
+        interval: 2000
+        running: NoctaliaBridge.desktopVisible
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: if (!setProc.running) getProc.running = true
+    }
+    Process {
+        id: getProc
+        command: ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const m = String(text).match(/Volume:\s*([0-9.]+)/);
+                if (m) { root.vol = parseFloat(m[1]); root.ok = true; }
+                root.muted = String(text).indexOf("MUTED") >= 0;
+            }
+        }
+    }
+    Process { id: setProc }
+    Process { id: muteProc; command: ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"] }
+}
diff --git a/widgets/glyph/GlyphBattery.qml b/widgets/glyph/GlyphBattery.qml
new file mode 100644
index 0000000..1f0e146
--- /dev/null
+++ b/widgets/glyph/GlyphBattery.qml
@@ -0,0 +1,15 @@
+import QtQuick
+import Quickshell.Services.UPower
+import "."
+
+// Battery ring (UPower). Red under 15% while not charging. A desktop PC has no battery: shows "--".
+GlyphRingStat {
+    readonly property var bat: UPower.displayDevice
+    readonly property bool has: !!bat && bat.ready && bat.isLaptopBattery
+    readonly property bool charging: has && bat.state === UPowerDeviceState.Charging
+    warnAt: 2                                  // never "full = red"; low is handled below
+    f: has ? bat.percentage : 0
+    value: has ? String(Math.round(bat.percentage * 100)) : "--"
+    label: !has ? "no battery" : charging ? "charging" : "battery"
+    tone: has && !charging && bat.percentage < 0.15 ? GlyphTheme.red : GlyphTheme.fg
+}
diff --git a/widgets/glyph/GlyphBitmap.qml b/widgets/glyph/GlyphBitmap.qml
new file mode 100644
index 0000000..90c09ab
--- /dev/null
+++ b/widgets/glyph/GlyphBitmap.qml
@@ -0,0 +1,31 @@
+import QtQuick
+import "."
+
+// Dot bitmap from rows of equal length: "#" lit, "R" red, "." unlit (hidden unless showOff).
+Item {
+    id: root
+    property var rows: []
+    property real cell: 8
+    property real dot: cell * 0.72
+    property color on: GlyphTheme.fg
+    property color off: GlyphTheme.s3
+    property bool showOff: false
+    readonly property int cols: rows.length > 0 ? rows[0].length : 0
+    width: cols * cell
+    height: rows.length * cell
+
+    Repeater {
+        model: root.rows.length * root.cols
+        Rectangle {
+            required property int index
+            readonly property string ch: (root.rows[Math.floor(index / root.cols)] || "")[index % root.cols] || "."
+            visible: ch !== "." || root.showOff
+            width: root.dot
+            height: root.dot
+            radius: root.dot / 2
+            x: (index % root.cols) * root.cell + (root.cell - root.dot) / 2
+            y: Math.floor(index / root.cols) * root.cell + (root.cell - root.dot) / 2
+            color: ch === "R" ? GlyphTheme.red : ch === "#" ? root.on : root.off
+        }
+    }
+}
diff --git a/widgets/glyph/GlyphCat.qml b/widgets/glyph/GlyphCat.qml
new file mode 100644
index 0000000..c8d0a79
--- /dev/null
+++ b/widgets/glyph/GlyphCat.qml
@@ -0,0 +1,41 @@
+import QtQuick
+import "."
+
+// A little dot cat (drawn here, not the glyph-rice gif): blinks now and then, wags its tail while you hover, red nose.
+GlyphCard {
+    id: w
+    designW: 220
+    designH: 220
+
+    readonly property var head: [
+        "..##.......##..", ".####.....####.", ".#############.", ".#############.", ".##..#####..##.",
+        ".##..#####..##.", ".#############.", "..####RRR####..", "...#########...", "..###########..",
+        ".#############.", ".####.###.####.", ".####.###.####."]
+    readonly property var headBlink: [
+        "..##.......##..", ".####.....####.", ".#############.", ".#############.", ".#############.",
+        ".##..#####..##.", ".#############.", "..####RRR####..", "...#########...", "..###########..",
+        ".#############.", ".####.###.####.", ".####.###.####."]
+    property bool blink: false
+    property bool wag: false
+    readonly property var tailUp:   ["..", "..", "..", "..", "..", "..", "..", ".#", "##", "#.", "#.", "#.", "##"]
+    readonly property var tailFlat: ["..", "..", "..", "..", "..", "..", "..", "..", "..", "..", ".#", "##", "##"]
+    readonly property var rows: {
+        const h = blink ? headBlink : head, t = wag ? tailFlat : tailUp, out = [];
+        for (let i = 0; i < h.length; i++) out.push(h[i] + t[i]);
+        return out;
+    }
+
+    Timer {
+        interval: 3200; running: true; repeat: true
+        onTriggered: { w.blink = true; off.restart(); }
+    }
+    Timer { id: off; interval: 160; onTriggered: w.blink = false }
+    Timer { interval: 420; running: ma.containsMouse; repeat: true; onTriggered: w.wag = !w.wag; onRunningChanged: if (!running) w.wag = false }
+
+    GlyphBitmap {
+        anchors.centerIn: parent
+        rows: w.rows
+        cell: 11
+    }
+    MouseArea { id: ma; anchors.fill: parent; hoverEnabled: true; onClicked: { w.blink = true; off.restart(); } }
+}
