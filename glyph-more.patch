+import QtQuick
+import "."
+
+// Volume ring (default output, wpctl). Wheel = volume, click = mute (the ring turns red while muted).
+GlyphRingStat {
+    id: w
+    warnAt: 2
+    f: GlyphAudioData.muted ? 0 : GlyphAudioData.vol
+    value: GlyphAudioData.ok ? String(Math.round(GlyphAudioData.vol * 100)) : "--"
