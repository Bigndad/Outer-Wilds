+++ b/widgets/glyph/GlyphWeather.qml
@@ -0,0 +1,52 @@
+import QtQuick
+import "."
+
+// Round weather tile: dot icon, temperature in dots, condition + low/high. Data: GlyphWeatherData (Open-Meteo).
+GlyphCard {
+    id: w
+    designW: 220
+    designH: 220
+    round: true
+
+    readonly property var icons: ({
+        sun:   ["....#.#....", "..#.....#..", "...#####...", "#..#####..#", "...#####...", "..#.....#..", "....#.#....", "...........", "..........."],
+        moon:  ["....###....", "..###......", ".###.......", ".###.......", ".###.......", ".####.....#", "..######.#.", "....####...", "..........."],
+        cloud: ["...........", "....###....", "..#######..", ".#########.", "###########", "###########", ".#########.", "...........", "..........."],
+        rain:  ["....###....", "..#######..", ".#########.", "###########", ".#########.", "...........", ".#..#..#...", "#..#..#..#.", "..#..#..#.."],
+        snow:  ["....###....", "..#######..", ".#########.", "###########", ".#########.", "...........", "..#...#...#", ".....#.....", "#...#...#.."],
+        storm: ["....###....", "..#######..", ".#########.", "###########", ".#########.", "....RR.....", "...RR......", "..RRRR.....", "....R......"],
+        fog:   ["...........", "..#######..", "...........", "#########..", "...........", "..#########", "...........", ".#######...", "..........."]
+    })
+    function iconFor(c, day) {
+        if (c === 0) return day ? "sun" : "moon";
+        if (c <= 3) return "cloud";
+        if (c <= 48) return "fog";
+        if (c <= 67 || (c >= 80 && c <= 82)) return "rain";
+        if (c <= 77 || c <= 86) return "snow";
+        return "storm";
+    }
+
+    readonly property bool ok: GlyphWeatherData.ok
+
+    GlyphBitmap {
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: 34
+        rows: w.icons[w.ok ? w.iconFor(GlyphWeatherData.code, GlyphWeatherData.day) : "cloud"]
+        cell: 7
+        on: w.ok ? GlyphTheme.fg : GlyphTheme.mute
+    }
+    GlyphDots {
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: 110
+        text: w.ok ? String(Math.round(GlyphWeatherData.temp)) + "\u00B0" : "--"
+        cell: 7
+    }
+    GlyphLabel {
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: 176
+        width: 150
+        horizontalAlignment: Text.AlignHCenter
+        elide: Text.ElideRight
+        text: w.ok ? GlyphWeatherData.desc(GlyphWeatherData.code) + " " + Math.round(GlyphWeatherData.tmin) + "/" + Math.round(GlyphWeatherData.tmax) : "no sky"
+    }
+}
diff --git a/widgets/glyph/GlyphWeatherData.qml b/widgets/glyph/GlyphWeatherData.qml
new file mode 100644
index 0000000..120b783
--- /dev/null
+++ b/widgets/glyph/GlyphWeatherData.qml
@@ -0,0 +1,57 @@
+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import "../.."
+
+// Shared Open-Meteo poll (no key) for the glyph weather widget: one curl every 15 min, only while the scene is visible.
+// Place: Mumbai (same coordinates as WeatherWidget.qml); change lat/lon here.
+Singleton {
+    id: root
+    property real lat: 18.91
+    property real lon: 72.81
+    property bool ok: false
+    property real temp: 0
+    property real tmin: 0
+    property real tmax: 0
+    property int code: 0
+    property bool day: true
+
+    function desc(c) {
+        if (c === 0) return "clear";
+        if (c <= 3) return "cloudy";
+        if (c <= 48) return "fog";
+        if (c <= 67) return "rain";
+        if (c <= 77) return "snow";
+        if (c <= 82) return "showers";
+        if (c <= 86) return "snow";
+        return "storm";
+    }
+
+    Timer {
+        interval: 900000
+        running: NoctaliaBridge.desktopVisible
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: proc.running = true
+    }
+    Process {
+        id: proc
+        command: ["curl", "-s", "--max-time", "8",
+            "https://api.open-meteo.com/v1/forecast?latitude=" + root.lat + "&longitude=" + root.lon
+            + "&current=temperature_2m,weather_code,is_day&daily=temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    const j = JSON.parse(text);
+                    root.temp = j.current.temperature_2m;
+                    root.code = j.current.weather_code;
+                    root.day = j.current.is_day === 1;
+                    root.tmin = j.daily.temperature_2m_min[0];
+                    root.tmax = j.daily.temperature_2m_max[0];
+                    root.ok = true;
+                } catch (e) { /* keep the last good values */ }
+            }
+        }
+    }
+}
