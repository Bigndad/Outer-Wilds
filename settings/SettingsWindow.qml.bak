import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import "../"

// Control Centre window on the right edge (Overlay layer), with click-through mask for the
// pop-out Inspector and native file dialogs (zenity / kdialog) for file pickers & preset I/O.
Scope {
    id: root

    property bool dialogOpen: false
    property var _pickCb: null

    IpcHandler {
        target: "settings"
        function toggle(): void { WidgetConfig.panelOpen = !WidgetConfig.panelOpen; }
        function show(): void { WidgetConfig.panelOpen = true; }
        function hide(): void { WidgetConfig.panelOpen = false; }
    }

    Connections {
        target: WidgetConfig
        function onPanelOpenChanged() {
            if (WidgetConfig.panelOpen) Qt.callLater(() => panel.forceActiveFocus());
            else WidgetConfig.previewId = "";
        }
    }

    function openFilePicker(title, zenFilter, kdFilter, cb) {
        if (dialogOpen) return;
        _pickCb = cb;
        dialogOpen = true;
        pickProc.command = [
            "sh", "-c",
            'if command -v zenity >/dev/null 2>&1; then zenity --file-selection --width=720 --height=480 --title="$1" --file-filter="$2" --file-filter="All files | *"; '
          + 'elif command -v kdialog >/dev/null 2>&1; then kdialog --getopenfilename "$HOME" "$3" --title "$1"; '
          + 'else echo "__NO_DIALOG__"; fi',
            "--", title || "Select file", zenFilter || "Images | *.png *.jpg *.jpeg *.webp *.gif", kdFilter || "*.png *.jpg *.jpeg *.webp *.gif"
        ];
        pickProc.running = true;
    }

    function exportPreset(name, jsonText) {
        if (dialogOpen) return;
        dialogOpen = true;
        const safe = (String(name || "outerwilds-layout").replace(/[^a-zA-Z0-9._-]+/g, "_")) || "outerwilds-layout";
        exportProc.command = [
            "sh", "-c",
            'OUT=""; '
          + 'if command -v zenity >/dev/null 2>&1; then OUT=$(zenity --file-selection --width=720 --height=480 --save --confirm-overwrite --title="Export layout preset" --filename="$HOME/$1.json" --file-filter="JSON | *.json"); '
          + 'elif command -v kdialog >/dev/null 2>&1; then OUT=$(kdialog --getsavefilename "$HOME/$1.json" "*.json" --title "Export layout preset"); '
          + 'else echo "__NO_DIALOG__"; exit 0; fi; '
          + 'if [ -n "$OUT" ]; then printf "%s" "$2" > "$OUT" && printf "OK:%s" "$OUT"; fi',
            "--", safe, jsonText
        ];
        exportProc.running = true;
    }

    function importPreset() {
        if (dialogOpen) return;
        dialogOpen = true;
        importProc.command = [
            "sh", "-c",
            'IN=""; '
          + 'if command -v zenity >/dev/null 2>&1; then IN=$(zenity --file-selection --width=720 --height=480 --title="Import layout preset" --file-filter="JSON | *.json" --file-filter="All files | *"); '
          + 'elif command -v kdialog >/dev/null 2>&1; then IN=$(kdialog --getopenfilename "$HOME" "*.json" --title "Import layout preset"); '
          + 'else echo "__NO_DIALOG__"; exit 0; fi; '
          + 'if [ -n "$IN" ] && [ -f "$IN" ]; then printf "NAME:%s\n" "$(basename "$IN" .json)"; cat "$IN"; fi'
        ];
        importProc.running = true;
    }

    Process {
        id: pickProc
        stdout: StdioCollector {
            onStreamFinished: {
                const out = text.trim();
                const cb = root._pickCb;
                root._pickCb = null;
                root.dialogOpen = false;
                if (WidgetConfig.panelOpen) Qt.callLater(() => panel.forceActiveFocus());
                if (out === "__NO_DIALOG__") { panel.presetMsg = "Install zenity or kdialog for file dialogs."; return; }
                if (out !== "" && typeof cb === "function") cb(out);
            }
        }
    }

    Process {
        id: exportProc
        stdout: StdioCollector {
            onStreamFinished: {
                const out = text.trim();
                root.dialogOpen = false;
                if (WidgetConfig.panelOpen) Qt.callLater(() => panel.forceActiveFocus());
                if (out === "__NO_DIALOG__") panel.presetMsg = "Install zenity or kdialog to export presets.";
                else if (out.startsWith("OK:")) panel.presetMsg = "Exported to " + out.slice(3);
            }
        }
    }

    Process {
        id: importProc
        stdout: StdioCollector {
            onStreamFinished: {
                const raw = text;
                root.dialogOpen = false;
                if (WidgetConfig.panelOpen) Qt.callLater(() => panel.forceActiveFocus());
                if (raw.trim() === "__NO_DIALOG__") { panel.presetMsg = "Install zenity or kdialog to import presets."; return; }
                if (raw.trim() === "") return;
                const nl = raw.indexOf("\n");
                let fallback = "Imported", body = raw;
                if (raw.startsWith("NAME:") && nl > 0) {
                    fallback = raw.slice(5, nl).trim() || "Imported";
                    body = raw.slice(nl + 1);
                }
                const res = WidgetConfig.importPresetJson(body, fallback);
                panel.presetMsg = res.ok ? ("Imported & loaded '" + res.name + "'") : res.error;
            }
        }
    }

    PanelWindow {
        visible: panel.panelShown
        color: "transparent"
        exclusionMode: ExclusionMode.Ignore
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "outerwilds-settings"
        WlrLayershell.keyboardFocus: (WidgetConfig.panelOpen && !root.dialogOpen) ? (panel.capturing !== "" ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.OnDemand) : WlrKeyboardFocus.None
        anchors { top: true; bottom: true; right: true }
        // Fixed width: resizing a layer-shell surface every time the inspector opens/closes made the whole
        // panel re-configure and flicker. The transparent part is made click-through by the mask below.
        implicitWidth: 810
        mask: Region {
            item: panel.mainPanelItem
            Region { item: panel.inspectorHitItem }
        }

        SettingsPanel {
            id: panel
            anchors.fill: parent
            onCloseRequested: WidgetConfig.panelOpen = false
            onFlyRequested: (planetId) => { if (planetId !== "") NoctaliaBridge.planetRequested(planetId, "settings"); }
            onFileBrowseRequested: (title, zenFilter, kdFilter, cb) => root.openFilePicker(title, zenFilter, kdFilter, cb)
            onPresetExportRequested: (name, jsonText) => root.exportPreset(name, jsonText)
            onPresetImportRequested: root.importPreset()
        }
    }
}
