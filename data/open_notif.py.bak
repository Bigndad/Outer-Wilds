#!/usr/bin/env python3
"""Open the app / window behind a notification.
args: app_id app_name image summary body   (the last two are optional)
Every decision is logged to ~/.cache/ow-shell/open_notif.log so a failing app can be diagnosed.
"""
import json, os, re, subprocess, sys, time

LOG = os.path.expanduser("~/.cache/ow-shell/open_notif.log")


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(time.strftime("%H:%M:%S ") + msg + "\n")
    except OSError:
        pass


def arg(i):
    return (sys.argv[i] if len(sys.argv) > i else "").strip()


app_id, app_name, image, summary, body = arg(1), arg(2), arg(3), arg(4), arg(5)
cache_prefix = os.path.expanduser("~/.cache/ow-shell/notif-imgs/")
log(f"open app_id={app_id!r} app={app_name!r} summary={summary!r} image={image[:60]!r}")


def done(how):
    log("-> " + how)
    sys.exit(0)


def norm(s):
    return re.sub(r"[^a-z0-9]+", "", s.lower())


# 1. A real attachment (e.g. a Hyprshot screenshot) opens directly. Temp/runtime files are
#    avatars/favicons that browsers hand over, not something to open.
if image.startswith("file://"):
    fpath = image[7:]
    if (os.path.isfile(fpath) and not fpath.startswith(cache_prefix)
            and not fpath.startswith(("/tmp/", "/run/", "/var/tmp/"))):
        subprocess.Popen(["xdg-open", fpath], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        done("xdg-open " + fpath)

# 2. Tokens that identify the app: full ids/names and their meaningful words
GENERIC = {"browser", "desktop", "app", "the", "google", "web", "org", "com", "gnome", "kde", "client", "stable"}
full, words = [], []
for raw in (app_id, app_name):
    low = raw.lower().strip()
    if low.endswith(".desktop"):
        low = low[:-8]
    if not low:
        continue
    for t in {low, norm(low), low.split(".")[-1]}:
        if t and t not in full:
            full.append(t)
    for w in re.split(r"[^a-z0-9]+", low):
        if len(w) >= 3 and w not in GENERIC and w not in words:
            words.append(w)

# words from the notification text, used only to choose between several windows of the same app
# (e.g. two Zen windows: the one titled "Instagram" wins for an Instagram notification)
hints = [w for w in set(re.findall(r"[a-z0-9]{4,}", (summary + " " + body).lower()))]


def pick_window():
    try:
        out = subprocess.check_output(["hyprctl", "-j", "clients"], text=True, stderr=subprocess.DEVNULL)
        clients = json.loads(out)
    except Exception as e:
        log(f"hyprctl failed: {e}")
        return None
    best, best_key = None, None
    for c in clients:
        if not c.get("mapped", True):
            continue
        cls = norm(str(c.get("class", "")) + " " + str(c.get("initialClass", "")))
        title = str(c.get("title", "") or "").lower()
        ntitle = norm(title)
        score = 0
        for t in full:
            nt = norm(t)
            if nt and nt in cls:
                score = max(score, 4)
            elif t in title or (nt and nt in ntitle):
                score = max(score, 2)
        for w in words:
            if w in cls:
                score = max(score, 3)
        if score == 0:
            continue
        bonus = sum(1 for h in hints if h in title)
        key = (score + min(bonus, 3) * 2, -int(c.get("focusHistoryID", 99)))
        if best_key is None or key > best_key:
            best, best_key = c, key
    return best


if full or words:
    c = pick_window()
    if c and c.get("address"):
        subprocess.Popen(["hyprctl", "dispatch", "focuswindow", f"address:{c['address']}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        done(f"focus {c.get('class')!r} / {str(c.get('title'))[:50]!r}")
    log("no matching window")


# 3. Fallback: launch the desktop entry
def try_launch(desktop_id):
    if not desktop_id:
        return False
    return subprocess.run(["gtk-launch", desktop_id], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


if app_id and try_launch(app_id):
    done("gtk-launch " + app_id)

tokens = full + words
for d in (os.path.expanduser("~/.local/share/applications"), "/usr/share/applications"):
    if not os.path.isdir(d):
        continue
    for fn in sorted(os.listdir(d)):
        if not fn.endswith(".desktop"):
            continue
        stem = fn[:-8].lower()
        if any(t == stem or (len(t) >= 3 and t in stem) for t in tokens) and try_launch(fn):
            done("gtk-launch " + fn)
        try:
            with open(os.path.join(d, fn), "r", errors="ignore") as f:
                head = f.read(1500).lower()
            if any(f"name={t}" in head or f"startupwmclass={t}" in head for t in tokens) and try_launch(fn):
                done("gtk-launch " + fn + " (Name/StartupWMClass)")
        except OSError:
            pass
log("nothing worked")
