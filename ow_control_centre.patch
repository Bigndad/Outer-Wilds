diff --git a/core/KeyHost.qml b/core/KeyHost.qml
new file mode 100644
index 0000000..7a1fc92
--- /dev/null
+++ b/core/KeyHost.qml
@@ -0,0 +1,45 @@
+import QtQuick
+import QtQml
+import "../"
+
+// Turns the Keybinds table into the real keys. Lives inside the scene (CameraRig), next to MapHost / RumorMap, so these are
+// ordinary window Shortcuts like N / L / Q always were (they need the scene to have keyboard focus; for focus-free keys use the IPC calls).
+//   * map / rumor / scope keys are handed to the existing owners (MapData.toggleKey, RumorData.toggleKey, SignalscopeData.keys);
+//     their own Shortcuts then follow automatically.
+//   * edit / keys / hud are handled here.
+// No Quickshell import (CameraRig also runs in plain `qml`).
+Item {
+    id: host
+    visible: false
+    width: 0; height: 0
+
+    Binding { target: MapData;         property: "toggleKey"; value: Keybinds.seq("map") }
+    Binding { target: RumorData;       property: "toggleKey"; value: Keybinds.seq("rumor") }
+    Binding { target: SignalscopeData; property: "keys";      value: Keybinds.scopeKeys() }
+
+    // the overlays handle their own keys while they are up (the map's E = edit widgets); never type-trigger while a text field is active
+    readonly property bool free: !MapData.open && !RumorData.open && !RumorData.typing
+
+    Shortcut {
+        sequence: Keybinds.seq("edit")
+        enabled: host.free
+        autoRepeat: false
+        onActivated: WidgetConfig.panelOpen = !WidgetConfig.panelOpen
+    }
+    Shortcut {
+        sequence: Keybinds.seq("keys")
+        enabled: !RumorData.typing
+        autoRepeat: false
+        onActivated: {
+            if (WidgetConfig.panelOpen && WidgetConfig.panelTab === "keys") { WidgetConfig.panelOpen = false; return; }
+            WidgetConfig.panelTab = "keys";
+            WidgetConfig.panelOpen = true;
+        }
+    }
+    Shortcut {
+        sequence: Keybinds.seq("hud")
+        enabled: host.free
+        autoRepeat: false
+        onActivated: WidgetConfig.setShowLoopPanel(!WidgetConfig.showLoopPanel)
+    }
+}
diff --git a/data/Keybinds.qml b/data/Keybinds.qml
new file mode 100644
index 0000000..56bd4a6
--- /dev/null
+++ b/data/Keybinds.qml
@@ -0,0 +1,158 @@
+pragma Singleton
+import QtQuick
+
+// =====================================================================
+//  Keybinds: the ONE list of every key in the shell.
+//   * `actions`   keys you can rebind (the Control Centre's KEYS tab edits them).
+//   * `reference` keys that are fixed (flight, map / rumor-map internals); shown for reading only.
+//   * Changed keys live in WidgetConfig.keyOverrides (saved in widgets.json under "keys"); everything else
+//     uses `def` below. KeyHost.qml turns them into the real Shortcuts and into MapData / RumorData /
+//     SignalscopeData key settings.
+//   * Only the keys that differ from the default are stored, so changing a default here updates everyone
+//     who never touched that key.
+//  No Quickshell import (loads in plain `qml` on the Mint laptop too).
+// =====================================================================
+QtObject {
+    id: root
+
+    readonly property string gAnywhere: "In the scene"
+    readonly property string gScope: "Signalscope (while equipped)"
+
+    // id -> `scopeKey` is the name SignalscopeData.keys uses for it
+    readonly property var actions: [
+        { id: "map",       group: gAnywhere, label: "Map View",             hint: "open / close the ship-log map",     def: "N" },
+        { id: "rumor",     group: gAnywhere, label: "Rumor Map",            hint: "open / close the notification map", def: "L" },
+        { id: "edit",      group: gAnywhere, label: "Widget control",       hint: "open / close this panel",           def: "E" },
+        { id: "keys",      group: gAnywhere, label: "Key list",             hint: "open this panel on the KEYS tab",   def: "F1" },
+        { id: "hud",       group: gAnywhere, label: "Loop / speed panel",   hint: "show / hide the bottom-right box",  def: "H" },
+        { id: "scope",     group: gAnywhere, label: "Signalscope",          hint: "equip / stow",                      def: "Q", scopeKey: "toggle" },
+        { id: "chanPrev",  group: gScope,    label: "Previous channel",     hint: "",                                  def: "Left",  scopeKey: "chanPrev" },
+        { id: "chanNext",  group: gScope,    label: "Next channel",         hint: "",                                  def: "Right", scopeKey: "chanNext" },
+        { id: "playPause", group: gScope,    label: "Play / pause",         hint: "",                                  def: "P",     scopeKey: "playPause" },
+        { id: "trackPrev", group: gScope,    label: "Previous track",       hint: "",                                  def: ",",     scopeKey: "trackPrev" },
+        { id: "trackNext", group: gScope,    label: "Next track",           hint: "",                                  def: ".",     scopeKey: "trackNext" },
+        { id: "mute",      group: gScope,    label: "Mute",                 hint: "",                                  def: "M",     scopeKey: "mute" },
+        { id: "volUp",     group: gScope,    label: "Volume up",            hint: "",                                  def: "Up",    scopeKey: "volUp" },
+        { id: "volDown",   group: gScope,    label: "Volume down",          hint: "",                                  def: "Down",  scopeKey: "volDown" }
+    ]
+
+    // read-only: [ group, [ [keys, what it does], ... ] ]
+    readonly property var reference: [
+        { group: "Flying (fixed)", rows: [
+            ["W  S",              "forward / back (zoom while locked on a planet)"],
+            ["A  D",              "strafe (turn while locked)"],
+            ["Space  Shift",      "up / down"],
+            ["Ctrl",              "drift on / off"],
+            ["Esc",               "let go of the planet"],
+            ["Click",             "centre on a planet"],
+            ["Double-click",      "lock and orbit (Alt+click = fly in)"] ] },
+        { group: "Map View (fixed)", rows: [
+            ["← → ↑ ↓",           "move the selection"],
+            ["Enter  Space",      "open the planet page"],
+            ["+  −",              "zoom the map"],
+            ["R",                 "Rumor Mode"],
+            ["E",                 "edit widgets"],
+            ["Esc  Backspace",    "back / close"] ] },
+        { group: "Rumor Map (fixed)", rows: [
+            ["← → ↑ ↓",           "move between notifications"],
+            ["Enter",             "explore"],
+            ["O  P  X",           "open / pin / dismiss"],
+            ["U",                 "unread only"],
+            ["/",                 "search"],
+            ["Home  +  −",        "fit / zoom"],
+            ["Esc",               "close"] ] }
+    ]
+
+    // Flight keys; a shortcut on these would fight the camera. Ctrl and Shift are modifiers the camera uses as keys.
+    readonly property var reserved: ["w", "a", "s", "d", "space", "esc", "escape", "return", "enter", "tab", "backspace"]
+
+    // ---------------- lookups ----------------
+    function _find(id) {
+        for (let i = 0; i < actions.length; i++) if (actions[i].id === id) return actions[i];
+        return null;
+    }
+    function defOf(id) { const a = _find(id); return a ? a.def : ""; }
+    function labelOf(id) { const a = _find(id); return a ? a.label : id; }
+    function isCustom(id) { return WidgetConfig.keyOverrides[id] !== undefined; }
+
+    // the key an action uses right now (reads keyOverrides, so bindings follow changes)
+    function seq(id) {
+        const o = WidgetConfig.keyOverrides;
+        if (o && o[id] !== undefined) return o[id];
+        return defOf(id);
+    }
+
+    // object in SignalscopeData.keys format: { toggle, chanPrev, ... }
+    function scopeKeys() {
+        const out = {};
+        for (let i = 0; i < actions.length; i++)
+            if (actions[i].scopeKey !== undefined) out[actions[i].scopeKey] = seq(actions[i].id);
+        return out;
+    }
+
+    // action id that already uses `s` (other than `exceptId`), or ""
+    function owner(s, exceptId) {
+        const want = String(s).toLowerCase();
+        for (let i = 0; i < actions.length; i++)
+            if (actions[i].id !== exceptId && String(seq(actions[i].id)).toLowerCase() === want) return actions[i].id;
+        return "";
+    }
+
+    // ---------------- display ----------------
+    function pretty(s) {
+        const map = { "Left": "←", "Right": "→", "Up": "↑", "Down": "↓", "Comma": ",", "Period": "." };
+        const parts = String(s).split("+");
+        for (let i = 0; i < parts.length; i++) if (map[parts[i]] !== undefined) parts[i] = map[parts[i]];
+        return parts.join(" + ");
+    }
+
+    // ---------------- capture ----------------
+    readonly property var _special: ({
+        [Qt.Key_Left]: "Left", [Qt.Key_Right]: "Right", [Qt.Key_Up]: "Up", [Qt.Key_Down]: "Down",
+        [Qt.Key_Comma]: ",", [Qt.Key_Period]: ".", [Qt.Key_Slash]: "/", [Qt.Key_Semicolon]: ";",
+        [Qt.Key_Apostrophe]: "'", [Qt.Key_BracketLeft]: "[", [Qt.Key_BracketRight]: "]",
+        [Qt.Key_Minus]: "-", [Qt.Key_Equal]: "=", [Qt.Key_Backslash]: "\\", [Qt.Key_QuoteLeft]: "`",
+        [Qt.Key_Home]: "Home", [Qt.Key_End]: "End", [Qt.Key_PageUp]: "PgUp", [Qt.Key_PageDown]: "PgDown",
+        [Qt.Key_Insert]: "Ins", [Qt.Key_Delete]: "Del"
+    })
+
+    // KeyEvent -> Qt Shortcut sequence, or "" for a modifier on its own / a key we cannot express
+    function fromEvent(ev) {
+        const k = ev.key;
+        if (k === Qt.Key_Shift || k === Qt.Key_Control || k === Qt.Key_Alt || k === Qt.Key_Meta || k === Qt.Key_AltGr) return "";
+        let name = _special[k];
+        if (name === undefined) {
+            if (k >= Qt.Key_A && k <= Qt.Key_Z) name = String.fromCharCode(k);
+            else if (k >= Qt.Key_0 && k <= Qt.Key_9) name = String.fromCharCode(k);
+            else if (k >= Qt.Key_F1 && k <= Qt.Key_F12) name = "F" + (k - Qt.Key_F1 + 1);
+            else return "";
+        }
+        let mods = "";
+        if (ev.modifiers & Qt.ControlModifier) mods += "Ctrl+";
+        if (ev.modifiers & Qt.AltModifier) mods += "Alt+";
+        if (ev.modifiers & Qt.ShiftModifier) mods += "Shift+";
+        if (ev.modifiers & Qt.MetaModifier) mods += "Meta+";
+        return mods + name;
+    }
+
+    // "" = fine, otherwise the reason this key cannot be used
+    function check(id, s) {
+        if (s === "") return "That key cannot be used.";
+        const low = s.toLowerCase();
+        if (low.indexOf("ctrl+") >= 0 || low.indexOf("shift+") >= 0)
+            return "Ctrl and Shift are flight keys; use Alt, or a plain key.";
+        if (low.indexOf("meta+") >= 0) return "Meta belongs to the compositor.";
+        if (reserved.indexOf(low) >= 0) return "That key is used for flying or navigation.";
+        const o = owner(s, id);
+        if (o !== "") return "Already used by " + labelOf(o) + ".";
+        return "";
+    }
+
+    // returns "" on success, else the reason
+    function assign(id, s) {
+        const why = check(id, s);
+        if (why !== "") return why;
+        if (s === defOf(id)) WidgetConfig.resetKey(id); else WidgetConfig.setKey(id, s);
+        return "";
+    }
+}
